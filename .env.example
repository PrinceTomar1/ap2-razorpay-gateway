# ---------------------------------------------------------------------------
# ap2-razorpay-gateway — environment
#
# Copy to .env:   cp .env.example .env
#
# EVERY variable below has a working default. With this file copied verbatim
# and no edits, `make demo` runs end to end with ZERO network access.
# You only need to fill anything in for the optional live Razorpay check.
# ---------------------------------------------------------------------------

# --- Payment rail selection -------------------------------------------------
# fake     : deterministic in-memory simulator. No network. Default. Used by
#            every test and by `make demo`.
# razorpay : the real Razorpay SDK against TEST-mode keys. Used by
#            `make demo LIVE=1` only.
PAYMENT_RAIL=fake

# --- Razorpay TEST-mode credentials ----------------------------------------
# Required ONLY when PAYMENT_RAIL=razorpay. Get these from
# Razorpay Dashboard -> Settings -> API Keys, with the dashboard in Test Mode.
# A test key id always starts with "rzp_test_". NEVER put a live key here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Webhook signing secret. Razorpay Dashboard -> Settings -> Webhooks -> the
# secret you chose when creating the webhook. Used to verify X-Razorpay-Signature.
# Leave blank to run without webhooks (the gateway falls back to polling
# fetch_order_payments — see docs/RAZORPAY_TESTING.md).
RAZORPAY_WEBHOOK_SECRET=

# How long the live rail polls Razorpay for a terminal payment state, in
# seconds, before giving up and reporting a timeout to the recovery playbook.
RAZORPAY_POLL_TIMEOUT_SECONDS=180
RAZORPAY_POLL_INTERVAL_SECONDS=3

# --- Anthropic (narration + optional agent product selection) --------------
# OPTIONAL. The LLM is never on the money path — it only writes the plain
# English "why" column in the audit log and, in `--llm` agent mode, picks which
# SKU to look at. With no key set, everything falls back to deterministic
# templates and the run is byte-for-byte identical minus the prose.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# fake | anthropic. `fake` uses the built-in deterministic FakeLLM.
LLM_PROVIDER=fake

# --- Storage ---------------------------------------------------------------
# SQLite file for the tamper-evident audit chain and the idempotency store.
# Use ":memory:" for an ephemeral run.
GATEWAY_DB=run/gateway.db

# Where signing keys live, so a receipt issued before a restart still verifies
# after one. Leave EMPTY for ephemeral keys — that is right for tests and for
# `make demo`, which have nothing to be evidence for. `make serve` sets this,
# because a gateway that forgets who it is cannot honour receipts it has already
# issued. The file is created 0600 and the gateway refuses to start if it is
# readable by anyone else. It is NOT a KMS; see LIMITATIONS.md.
GATEWAY_KEYSTORE=

# --- Service ---------------------------------------------------------------
# Host/port for `make serve` (webhook receiver + Trusted Surface approval page).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Injected by the hosting platform (Railway, Render, Fly, Heroku). It OVERRIDES
# GATEWAY_PORT, and its presence also switches the bind address to 0.0.0.0 —
# a container that binds loopback fails its health check forever. Leave this
# empty locally; you do not set it by hand.
PORT=
# Public base URL the Trusted Surface links are built from. When you tunnel
# with ngrok for webhooks, put the https ngrok URL here.
GATEWAY_PUBLIC_URL=http://127.0.0.1:8000

# --- Policy ----------------------------------------------------------------
# Path to the declarative bounds (budgets, recovery caps, breaker thresholds).
POLICY_FILE=config/policy.yaml
