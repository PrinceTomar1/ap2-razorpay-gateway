# Secrets — never commit
.env
.env.local
*.pem
keys/

# Databases / runtime state
*.db
keystore.json
run/keystore.json
*.sqlite
*.sqlite3
demo/report.json
run/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Generated by `make demo` / `make redteam` / `make bench` / `make interop`.
# Committed deliberately — they are evidence, and a reviewer should see them
# without running anything. Listed here only to document that they regenerate.

# Intermediate video build products; the finished mp4 IS committed.
video/clip_*.mp4
video/concat.txt
video/durations.json
video/voice/.DS_Store

# scratch from the audio pass (wavs, STT output)
video/work/
video/clip_*.mp4
video/concat.txt
