# Secrets — never commit
.env
.env.local
*.pem
keys/

# Databases / runtime state
*.db
*.db-journal
*.sqlite
*.sqlite3
demo/report.json
run/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Generated by `make demo` / `make redteam` / `make bench` / `make interop`.
# Committed deliberately — they are evidence, and a reviewer should see them
# without running anything. Listed here only to document that they regenerate.
